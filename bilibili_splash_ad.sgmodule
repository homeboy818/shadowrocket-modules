#!name=哔哩哔哩去开屏广告
#!desc=清空 B 站开屏广告列表（含品牌/活动开屏），并拦截开屏图片、视频素材和广告曝光上报。需开启 MITM。根据 2026-10-18 代理日志整理。
#!author=homeboy818
#!category=去广告

[Rule]
# 广告曝光/点击上报
DOMAIN,cm.bilibili.com,REJECT
DOMAIN,impression.biligame.com,REJECT
DOMAIN-SUFFIX,tanx.com,REJECT

[URL Rewrite]
# 开屏视频素材（http 明文，无需 MITM）
^https?:\/\/upos-[^\/]+\.bilivideo\.com\/ssaxcode\/.+SPLASH\.mp4 - reject
# 开屏/商业图片素材（sycp = 商业产品，sycp_brand = 品牌开屏）
^https?:\/\/i\d\.hdslb\.com\/bfs\/sycp(_brand)?\/ - reject-img

[Script]
# 清空开屏列表：list / show / brand/list / event/list2
bili-splash = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(list|show|brand\/list|event\/list2),requires-body=1,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/homeboy818/shadowrocket-modules/main/scripts/bilibili_splash.js

[MITM]
hostname = %APPEND% app.bilibili.com, i0.hdslb.com, i1.hdslb.com, i2.hdslb.com
